snippet box "Create a box arround the text"
    \noindent\fbox{%
        \parbox{\textwidth}{%
            ${0:${VISUAL:Text}}
        }%
    }%

snippet mn "Unnumbered equation"
    \[
        ${0:${VISUAL:Equation}}
    \]

snippet frame "Create beamer frame"
    \\begin{frame}{${1:Title}}
    $0
    \\end{frame}

snippet dma "Create latex editting command"
    \\usepackage{ifthen}
    \\usepackage[normalem\]{ulem}

    \\newcommand\\orangesout{\\bgroup\\markoverwith{\\textcolor{orange}{\\rule[0.5ex\\]{2pt}{0.4pt}}}\\ULon}%
    \\newcommand{\\ma}[2\]{\\ifthenelse{\\equal{#1}{}}{\\textcolor{orange}{#2}}{\\ifthenelse{\\equal{#2}{}}{\\orangesout{#1}}{\\orangesout{#1} \\textcolor{orange}{#2}}}}%
    % \\renewcommand{\\ma}[2\]{\\textcolor{orange}{#2}}
    % \\renewcommand{\\ma}[2\]{#2}

snippet ma "Insert editting command"
    \\ma{${VISUAL}}{$0}
